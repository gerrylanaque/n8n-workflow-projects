    {
      "parameters": {
        "jsCode": "// 1. Fetch parsed items from your LLM Extract node\nconst parsedItems = $('extract').item.json.output.parsed_items || [];\n\n// 2. Fetch inventory rows from your Airtable node\nconst inventoryRows = $('Search records').all(); \n\nlet inStockCount = 0;\nlet outOfStockCount = 0;\n\n// Cross-reference parsed order items against Airtable stock\nparsedItems.forEach(item => {\n  const matchedProduct = inventoryRows.find(row => {\n    const fields = row.json.fields || row.json;\n    const productName = (fields.name || fields.product_name || '').toLowerCase();\n    const itemMention = (item.product_name || item.product_mention || '').toLowerCase();\n    return productName.includes(itemMention) || itemMention.includes(productName);\n  });\n\n  if (matchedProduct) {\n    const fields = matchedProduct.json.fields || matchedProduct.json;\n    if (fields.in_stock === true || fields.in_stock === 'TRUE' || fields.in_stock === 1) {\n      inStockCount++;\n    } else {\n      outOfStockCount++;\n    }\n  } else {\n    outOfStockCount++;\n  }\n});\n\n// Calculate items_in_stock flag\nlet itemsInStockFlag = \"all\";\nif (outOfStockCount > 0 && inStockCount > 0) {\n  itemsInStockFlag = \"partial\";\n} else if (outOfStockCount > 0 && inStockCount === 0) {\n  itemsInStockFlag = \"none\";\n}\n\n// Check text for urgency and substitution keywords\nconst rawOrderText = $('extract').item.json.output.raw_order_text || '';\nconst notesForHuman = $('extract').item.json.output.notes_for_human || '';\nconst fullText = (rawOrderText + ' ' + notesForHuman).toLowerCase();\n\nconst urgencyWords = ['urgent', 'asap', 'today', 'thursday', 'tasting event', 'rushed'];\nconst urgencyPresent = urgencyWords.some(word => fullText.includes(word));\n\nconst substitutionWords = ['swap', 'substitute', 'instead', 'replace', 'alternative'];\nconst substitutionsPresent = substitutionWords.some(word => fullText.includes(word));\n\n// Output payload for your Bounded AI Agent\nreturn {\n  json: {\n    raw_order_text: rawOrderText,\n    customer: {\n      customer_id: $('extract').item.json.output.customer_id,\n      name: $('extract').item.json.output.company_name,\n      tier: \"regular\",\n      usual_pattern: \"4kg house blend weekly\"\n    },\n    parsed_items: parsedItems,\n    deterministic_flags: {\n      items_in_stock: itemsInStockFlag,\n      urgency_words_present: urgencyPresent,\n      substitutions_present: substitutionsPresent,\n      quantity_within_usual: true\n    }\n  }\n};"
      },
