            {
              "id": "da36b679-6a4c-4860-9fbc-36cb0e20a2b8",
              "name": "prompt",
              "value": "={{ $json.messages.system }}  User request: {{ $json.messages.userRequest }}  Conversation history so far: {{ JSON.stringify($json.messages.history) }}  Tools already called: {{ $json.messages.history.map(item => item.tool).join(', ') || 'none' }}  Iteration: {{ $json.messages.iterationCount }} of 5 max.  Respond with EITHER: - A tool call: {\"action\": \"tool_call\", \"name\": \"...\", \"toolInput\": {...}} - A final brief: {\"action\": \"final\", \"brief\": {...}}  Rules: - Always call lookupAccount first. - Do not call the same tool twice. - For renewal calls, call lookupAccount, getUsageMetrics, getBillingStatus, and getRecentInteractions before returning final. - For incident follow-ups, call lookupAccount, getTicketHistory, and getRecentInteractions before returning final. - For general briefs, call all available tools before returning final. - If the required tools for the request type have already been called, return final. - If iterationCount is 4 or higher, return final using the information already in history.  Respond with ONLY one JSON object. No preamble.",
              "type": "string"
            }
          ]
        },
